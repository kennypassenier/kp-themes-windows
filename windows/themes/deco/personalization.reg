Windows Registry Editor Version 5.00

; GENERATED by kp-themes 7.1.0 (gates/generate-desktop.mjs) - KP Art Deco. Do not edit.
; Desktop and lock screen pictures. Needs administrator rights. apply.ps1 -Skip lockscreen leaves them alone.

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\PersonalizationCSP]
"DesktopImagePath"="C:\\Users\\Public\\Pictures\\kp-themes\\deco.png"
"DesktopImageUrl"="C:\\Users\\Public\\Pictures\\kp-themes\\deco.png"
"DesktopImageStatus"=dword:00000001
"LockScreenImagePath"="C:\\Users\\Public\\Pictures\\kp-themes\\deco-lock.png"
"LockScreenImageUrl"="C:\\Users\\Public\\Pictures\\kp-themes\\deco-lock.png"
"LockScreenImageStatus"=dword:00000001

; The sign-in screen blurs the picture by default; 1 shows it as it is.
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\System]
"DisableAcrylicBackgroundOnLogon"=dword:00000001
